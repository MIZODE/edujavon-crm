{
	"openapi": "3.0.0",
	"components": {
		"examples": {},
		"headers": {},
		"parameters": {},
		"requestBodies": {},
		"responses": {},
		"schemas": {
			"LoginDto": {
				"description": "Login credentials DTO",
				"properties": {
					"phone": {
						"type": "string",
						"description": "User's phone number",
						"example": "+998901234567"
					},
					"password": {
						"type": "string",
						"description": "User's password",
						"example": "password123"
					}
				},
				"required": [
					"phone",
					"password"
				],
				"type": "object",
				"additionalProperties": false
			},
			"RegisterDto": {
				"description": "Registration details DTO",
				"properties": {
					"phone": {
						"type": "string",
						"description": "User's phone number",
						"example": "+998901234567"
					},
					"firstName": {
						"type": "string",
						"description": "User's first name",
						"example": "John"
					},
					"lastName": {
						"type": "string",
						"description": "User's last name",
						"example": "Doe"
					},
					"password": {
						"type": "string",
						"description": "User's password",
						"example": "password123"
					}
				},
				"required": [
					"phone",
					"firstName",
					"lastName",
					"password"
				],
				"type": "object",
				"additionalProperties": false
			},
			"SendCodeDto": {
				"description": "Send verification code DTO",
				"properties": {
					"phone": {
						"type": "string",
						"description": "User's phone number",
						"example": "+998901234567"
					}
				},
				"required": [
					"phone"
				],
				"type": "object",
				"additionalProperties": false
			},
			"VerifyCodeDto": {
				"description": "Verify code DTO",
				"properties": {
					"phone": {
						"type": "string",
						"description": "User's phone number",
						"example": "+998901234567"
					},
					"code": {
						"type": "string",
						"description": "6-digit verification code",
						"example": "123456"
					}
				},
				"required": [
					"phone",
					"code"
				],
				"type": "object",
				"additionalProperties": false
			},
			"LogOutDto": {
				"description": "Log Out DTO",
				"properties": {
					"refreshToken": {
						"type": "string",
						"description": "User's refresh token",
						"example": "refresh_token"
					}
				},
				"required": [
					"refreshToken"
				],
				"type": "object",
				"additionalProperties": false
			}
		},
		"securitySchemes": {}
	},
