{
    "entryFile": "src/server.ts",
    "noImplicitAdditionalProperties": "throw-on-extras",
    "controllerPathGlobs": [
        "src/modules/**/*.controller.ts"
    ],
    "spec": {
        "outputDirectory": "src",
        "specVersion": 3,
        "basePath": "/api/v1"
    },
    "routes": {
        "routesDir": "src/routes",
        "middleware": "express",
        "basePath": "/api/v1",
        "authenticationModule": "src/authentication.ts"
    }
}